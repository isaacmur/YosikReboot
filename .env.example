# Copy to .env.local (git-ignored). Never commit real values.

# Epic OAuth client used for the authorization-code and device-auth grants.
# This is the public Fortnite Android game client that community libraries
# (fnbr, fortnitepy) use. If auth fails, check it against fnbr's Constants file.
EPIC_CLIENT_ID=3f69e56c7649492c8cc29f1af08a8a12
EPIC_CLIENT_SECRET=b51ee9cb12234f50a69efa67ef53812e

# Client for the "open this link and approve" sign-in (`npm run epic:device-auth -- --link`).
# This is the public Switch game client community tools use for Epic's device
# code flow; the sign-in is exchanged into the client above before the device
# auth is created. If it fails, check it against current community sources.
EPIC_DEVICE_CODE_CLIENT_ID=98f7e42c2e3a4f86a74eb43fbb41ed39
EPIC_DEVICE_CODE_CLIENT_SECRET=0a2449a2-001a-451e-afec-3e812901c4d7

# Optional: a second client to exchange the token into, only if the events
# service rejects tokens from the client above (Phase 0 finds out).
EPIC_EVENTS_CLIENT_ID=
EPIC_EVENTS_CLIENT_SECRET=

# The secondary account's device auth, printed by `npm run epic:device-auth`.
EPIC_ACCOUNT_ID=
EPIC_DEVICE_ID=
EPIC_DEVICE_SECRET=

# Optional: a display name to test the name -> account ID lookup (e.g. your main account).
PROBE_DISPLAY_NAME=

# --- App (Phase 1) ---
# The one passphrase that unlocks the app (F32). Pick something long.
APP_PASSPHRASE=
# Signs the session cookie. Generate with: openssl rand -hex 32
COOKIE_SECRET=

# --- Calendar feed (Phase 4) ---
# Unlocks the subscribe-able calendar feed (/api/ics?token=...), since calendar
# apps can't sign in. At least 16 characters; leave empty to turn the feed off.
# Generate with: openssl rand -hex 16. Change it to cut off old subscriptions.
ICS_TOKEN=
