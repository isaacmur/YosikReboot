# Copy to .env.local (git-ignored). Never commit real values.

# Epic OAuth client used for the authorization-code and device-auth grants.
# This is the public Fortnite Android game client that community libraries
# (fnbr, fortnitepy) use. If auth fails, check it against fnbr's Constants file.
EPIC_CLIENT_ID=3f69e56c7649492c8cc29f1af08a8a12
EPIC_CLIENT_SECRET=b51ee9cb12234f50a69efa67ef53812e

# Optional: a second client to exchange the token into, only if the events
# service rejects tokens from the client above (Phase 0 finds out).
EPIC_EVENTS_CLIENT_ID=
EPIC_EVENTS_CLIENT_SECRET=

# The secondary account's device auth, printed by `npm run epic:device-auth`.
EPIC_ACCOUNT_ID=
EPIC_DEVICE_ID=
EPIC_DEVICE_SECRET=

# Optional: a display name to test the name -> account ID lookup (e.g. your main account).
PROBE_DISPLAY_NAME=
