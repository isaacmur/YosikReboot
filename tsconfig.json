{
  // Node-side code: Vercel functions, shared lib, scripts, tests, tool configs.
  // The browser app has its own config (tsconfig.app.json).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["api", "lib", "scripts", "test", "vite.config.ts"]
}
